{
  "name": "@hackcove/pixelslash-playwright",
  "version": "0.1.0",
  "description": "Take PixelSlash snapshots from your own Playwright tests: snapshot(page, name) writes a dir `pixelslash upload` takes.",
  "keywords": [
    "pixel-diff",
    "playwright",
    "screenshot",
    "visual-regression"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madangryscientist/pixelslash.git",
    "directory": "packages/playwright"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@hackcove/pixelslash": "workspace:*",
    "@hackcove/pixelslash-engine": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.4",
    "@types/pngjs": "^6.0.5",
    "playwright": "1.64.1",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}
