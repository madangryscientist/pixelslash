{
  "name": "cli",
  "sourceRoot": "packages/cli/src",
  "projectType": "application",
  "targets": {
    "typecheck": { "command": "tsc -p packages/cli/tsconfig.json" },
    "lint": {
      "command": "oxlint --type-aware --deny-warnings packages/cli && bun scripts/check-slop.ts packages/cli"
    },
    "test": { "command": "bun --bun vitest run", "options": { "cwd": "packages/cli" } },
    "build": {
      "command": "bun scripts/build-cli.ts",
      "options": { "cwd": "{workspaceRoot}" },
      "cache": false
    },
    "smoke": {
      "command": "bun --bun vitest run -c vitest.smoke.config.ts",
      "dependsOn": ["build"],
      "options": { "cwd": "packages/cli" },
      "cache": false
    }
  }
}
