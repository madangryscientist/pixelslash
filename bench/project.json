{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "bench",
  "sourceRoot": "bench/src",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "command": "tsc -p bench/tsconfig.json"
    },
    "lint": {
      "command": "oxlint --type-aware --deny-warnings bench && bun scripts/check-slop.ts bench"
    },
    "test": {
      "command": "bun --bun vitest run",
      "options": {
        "cwd": "bench"
      },
      "dependsOn": ["check"]
    },
    "corpus": {
      "command": "bun bench/src/generate.ts",
      "cache": false
    },
    "bench": {
      "command": "bun bench/src/run.ts",
      "cache": false
    },
    "perf": {
      "command": "bun bench/src/perf/run.ts",
      "cache": false
    },
    "perf-check": {
      "command": "bun bench/src/perf/run.ts --check",
      "cache": false
    },
    "check": {
      "command": "bun bench/src/check.ts",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/corpus/**/*",
        "{projectRoot}/corpus-holdout/**/*",
        "{projectRoot}/results/*.json",
        "{projectRoot}/package.json",
        "{workspaceRoot}/bun.lock",
        "{workspaceRoot}/packages/engine/src/index.ts",
        "{workspaceRoot}/packages/engine/src/diff.ts",
        "{workspaceRoot}/packages/engine/src/diff-options.ts",
        "{workspaceRoot}/packages/engine/src/regions.ts",
        "{workspaceRoot}/packages/engine/src/shift.ts"
      ]
    }
  }
}
