{
  "name": "pixelslash-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "bench"
  ],
  "type": "module",
  "scripts": {
    "pixelslash": "bun packages/cli/src/index.ts",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "nx run-many -t test",
    "bench": "nx run bench:bench --output-style=stream",
    "bench:check": "nx run bench:check --output-style=stream",
    "bench:perf": "bun bench/src/perf/run.ts",
    "bench:perf:check": "bun bench/src/perf/run.ts --check",
    "bench:decoders": "bun bench/src/perf/decoders.ts",
    "bench:import-flags": "bun bench/src/import-flags.ts",
    "wasm:build": "bun scripts/build-wasm.ts",
    "wasm:check": "bun scripts/build-wasm.ts --check"
  },
  "devDependencies": {
    "@nx/dotnet": "23.3.0",
    "@types/bun": "1.4.3",
    "@types/pngjs": "^6.0.5",
    "nx": "23.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "pngjs": "^7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
