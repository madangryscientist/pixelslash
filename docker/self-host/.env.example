# Copy to .env (gitignored) and fill in. Every name here is read by apps/web/deploy/docker/start.ts.

# Required: a GitHub OAuth app (GitHub -> Settings -> Developer settings -> OAuth Apps). Its
# Authorization callback URL is <the URL people open>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional. Generated into the volume on first start when unset; set them to manage them yourself.
# IMAGE_SIGNING_SECRET=   # openssl rand -hex 32
# MODEL_KEY_SECRET=       # openssl rand -base64 32; changing it makes stored model keys unreadable

# Optional: the host port (default 3000).
# PIXELSLASH_PORT=3000

# Optional: the rest of the Variables table in apps/web/SELF-HOST.md, by the same names, e.g.
# PIXELSLASH_PUBLIC_URL=https://review.example.com
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# SENTRY_DSN=
# DEFAULT_DIFF_LOCATION=server
