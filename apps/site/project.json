{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "site",
  "sourceRoot": "apps/site/src",
  "projectType": "application",
  "targets": {
    "typecheck": {
      "command": "tsr generate && tsc --noEmit",
      "options": {
        "cwd": "apps/site"
      }
    },
    "lint": {
      "command": "oxlint --type-aware --deny-warnings apps/site && bun scripts/check-slop.ts apps/site"
    },
    "test": {
      "command": "bun --bun vitest run",
      "options": {
        "cwd": "apps/site"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/SECURITY.md",
        "{workspaceRoot}/apps/web/SELF-HOST.md",
        "{workspaceRoot}/docs/cli.md",
        "{workspaceRoot}/docs/capabilities/data.json",
        "{workspaceRoot}/apps/web/github-app/manifest.json"
      ]
    },
    "build": {
      "command": "vite build",
      "options": {
        "cwd": "apps/site"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/SECURITY.md",
        "{workspaceRoot}/apps/web/SELF-HOST.md",
        "{workspaceRoot}/docs/cli.md",
        "{workspaceRoot}/docs/capabilities/data.json",
        "{workspaceRoot}/apps/web/github-app/manifest.json"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test:e2e": {
      "command": "playwright test",
      "options": {
        "cwd": "apps/site"
      },
      "dependsOn": ["build"]
    }
  }
}
