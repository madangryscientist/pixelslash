{
  "name": "@pixelslash/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsr generate && tsc --noEmit",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "PIXELSLASH_E2E_DEV=1 playwright test",
    "dogfood:upload": "rm -rf .wrangler/dogfood-snapshots && bun ../../packages/cli/src/index.ts capture --config e2e/dogfood-review.config.ts --out .wrangler/dogfood-snapshots --upload --server \"${PIXELSLASH_SERVER:?set PIXELSLASH_SERVER}\" --token-path \"${PIXELSLASH_TOKEN_FILE:?set PIXELSLASH_TOKEN_FILE}\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false"
  },
  "dependencies": {
    "@hackcove/theme-catppuccin-mocha": "^0.2.5",
    "@hackcove/ui": "^0.2.7",
    "@pixelslash/engine": "workspace:*",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-start": "1.169.3",
    "drizzle-orm": "^0.45.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@playwright/test": "1.60.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "vite": "^8.0.0",
    "vitest": "5.0.5",
    "wrangler": "^4.151.2"
  }
}
