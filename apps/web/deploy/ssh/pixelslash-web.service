# apps/web's production build on Miniflare, on :3000, with nothing in front of workerd
# (deploy/ssh/serve.ts, PS-220; it replaced `vite preview`). D1 and R2 are miniflare's, in
# apps/web/.wrangler/state, which every release links to the old checkout's (PS-225). It runs from
# the release `current` points at, which update.sh switches. See apps/web/README.md, "Run it on the
# Proxmox server".
[Unit]
Description=PixelSlash review app
# The diff sidecar (PS-203) is wanted, not required: without it the Worker diffs in-process, up to a limit.
After=network-online.target pixelslash-stub.service pixelslash-diff.service
Wants=network-online.target pixelslash-stub.service pixelslash-diff.service

[Service]
User=pixelslash
WorkingDirectory=/home/pixelslash/releases/current/apps/web
Environment=PATH=/home/pixelslash/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/pixelslash/.bun/bin/bun deploy/ssh/serve.ts
Restart=on-failure
RestartSec=2
# workerd steps from ~135 MB to 1.5-1.8 GB on an upload burst and keeps it until a restart (ob 1887,
# PS-155; apps/web/README.md, "Run it on the Proxmox server"). 2500M rests on that 1.8 GB plus the
# ~465 MiB one in-process diff at its limit added (PS-323, src/diff/compare.ts). Page cache from R2
# counts too and is reclaimed at the Max. The CT has 6 GiB and the Proxmox host is overcommitted, so
# this is a ceiling for a burst, not a reservation. Over MemoryMax the kernel
# kills it, and OOMPolicy=stop turns that into a failed unit that Restart= brings back whole, not a
# server with a dead workerd under it. No MemoryHigh and no swap (PS-323): over a High with nothing
# left to reclaim workerd sits in D state, port 3000 accepts connections and answers nothing, and
# systemd reads `active` so nothing restarts it. Do not add a High back.
MemoryMax=2500M
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
