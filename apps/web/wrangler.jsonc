{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixelslash-web",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // The ids are placeholders: creating the real D1 database and R2 bucket is the first
  // deploy's job (a human step), not this scaffold's. Local dev and tests use local state.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pixelslash",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "pixelslash-blobs" }],
  // The explain queue (ob 1875): a finalise sends one job per changed shot, and `src/server.ts`'s
  // `queue` explains it with the project's model off the request. The code stops at 3 tries and
  // stores why; max_retries is above it so the queue never drops a job the code has not settled.
  // One job per invocation: an invocation holds six connections, and one shot's calls fill them.
  "queues": {
    "producers": [{ "binding": "EXPLAIN", "queue": "pixelslash-explain" }],
    "consumers": [
      {
        "queue": "pixelslash-explain",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 4,
      },
    ],
  },
  // GITHUB_CLIENT_SECRET and MODEL_KEY_SECRET are secrets (`wrangler secret put`, or `.dev.vars` locally).
  // MODEL_KEY_SECRET (ob 1786) is base64 of 32 random bytes and seals each project's model API key at rest.
  "vars": {
    "GITHUB_CLIENT_ID": "",
    "GITHUB_OAUTH_BASE": "https://github.com",
    "GITHUB_API_BASE": "https://api.github.com",
    // Signs the short-lived image URLs. Set it with `wrangler secret put IMAGE_SIGNING_SECRET`.
    "IMAGE_SIGNING_SECRET": "",
    // The oldest `pixelslash` CLI the API takes (`x.y.z`); empty takes any. A CLI below it gets 426 `cli_outdated`.
    "MIN_CLI_VERSION": "",
    // Where a new project diffs (ob 1727): `ci` here; unset or anything else is `server`, the self-host default.
    "DEFAULT_DIFF_LOCATION": "ci",
    // Error reporting (PS-227), off while SENTRY_DSN is empty. Set the DSN with `wrangler secret put SENTRY_DSN`;
    // the release is the deployed commit and the environment names the deployment (`dev` here, `e2e`, `lan`).
    "SENTRY_DSN": "",
    "SENTRY_RELEASE": "",
    "SENTRY_ENVIRONMENT": "dev",
  },
  // `CLOUDFLARE_ENV=e2e`: the Playwright build, signing in against the local GitHub stub
  // (e2e/github-stub.ts). Bindings are not inherited by an env, so they repeat here.
  "env": {
    "e2e": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pixelslash",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "pixelslash-blobs" }],
      "queues": {
        "producers": [{ "binding": "EXPLAIN", "queue": "pixelslash-explain" }],
        "consumers": [
          {
            "queue": "pixelslash-explain",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_retries": 4,
          },
        ],
      },
      "vars": {
        "GITHUB_CLIENT_ID": "e2e-client",
        "GITHUB_CLIENT_SECRET": "e2e-secret",
        "GITHUB_OAUTH_BASE": "http://localhost:4174",
        "GITHUB_API_BASE": "http://localhost:4174",
        "IMAGE_SIGNING_SECRET": "e2e-image-secret",
        // A fixed test value (base64 of 32 zero bytes), never a real secret.
        "MODEL_KEY_SECRET": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
        // The LAN self-host's diff sidecar (PS-203, deploy/lan/diff-sidecar.ts) on loopback. The
        // Playwright run points it at its own sidecar's port (vite.config.ts). Cloudflare's vars
        // above never set it: there the server diff stays in-process (diff.wasm, as everywhere).
        "DIFF_SIDECAR_URL": "http://127.0.0.1:4181",
        // Off here; the Playwright run points it at its own ingest stub (vite.config.ts), and the
        // LAN self-host's `.dev.vars` sets the real DSN, release and `lan`.
        "SENTRY_DSN": "",
        "SENTRY_RELEASE": "e2e",
        "SENTRY_ENVIRONMENT": "e2e",
      },
    },
  },
}
